# 2 November 2026 : what the lit reference says about the real relief. Lit divided by flat base color leaves the shading alone; the relief depth and the light
# that best explain that shading are measured on the height, instead of being chosen by eye. Also tests whether the fine lines of the base color carry relief.
# FR : ce que dit la référence éclairée du vrai relief : éclairée divisée par base color plate laisse l'ombrage seul ; profondeur et lumière se mesurent, sans estime.
import json
import sys

import numpy as np
from PIL import Image
from scipy import ndimage as ndi

ROOT = "/Users/zenray/.claude/tmp/tmp-alien-skin-2-november-2026/"
PROJECT = "/Users/zenray/.claude/tmp/tmp-zenray-height/projects/AlienSkinRef/"
SIZE = 1024
TILE_M = 2.0


def load(p, mode="RGB"):
    a = np.asarray(Image.open(p).convert(mode).resize((SIZE, SIZE), Image.LANCZOS), np.float64) / 255.0
    return a


def load16(p):
    a = np.asarray(Image.open(p), np.float64) / 65535.0
    return np.asarray(Image.fromarray(a.astype(np.float32), "F").resize((SIZE, SIZE), Image.BICUBIC), np.float64)


lit = load(ROOT + "refs/lit_aligned_2048.png")
flat = load(ROOT + "refs/flat_aligned_2048.png")
h = load16(PROJECT + "versions/final/AlienSkinRef_H2/FINAL_height_untiled.png")
print("size used", SIZE, "lit mean", np.round(lit.reshape(-1, 3).mean(0), 3), "flat mean", np.round(flat.reshape(-1, 3).mean(0), 3))
# Registration: does the relief line up with the two images? FR : le relief est-il aligné avec les deux images ?
lum_lit = lit.mean(2)
lum_flat = flat.mean(2)
hp = lambda a, s: a - ndi.gaussian_filter(a, s)
for name, im in (("lit", lum_lit), ("flat", lum_flat)):
    a, b = hp(im, 16).ravel(), hp(h, 16).ravel()
    print(name, "vs height, band-pass correlation", round(float(np.corrcoef(a, b)[0, 1]), 4))
    # best integer shift by phase correlation
    A = np.fft.fft2(hp(im, 8)); B = np.fft.fft2(hp(h, 8))
    r = np.fft.ifft2(A * np.conj(B)).real
    dy, dx = np.unravel_index(np.argmax(np.abs(r)), r.shape)
    dy = dy - SIZE if dy > SIZE // 2 else dy
    dx = dx - SIZE if dx > SIZE // 2 else dx
    print(name, "best shift px at", SIZE, ":", dx, dy, "peak sign", np.sign(r[dy % SIZE, dx % SIZE]))
# Shading = lit / flat, in a roughly linear space. FR : l'ombrage = éclairée / plate, en espace à peu près linéaire.
to_lin = lambda a: np.clip(a, 1e-3, 1) ** 2.2
S = (to_lin(lit) / np.maximum(to_lin(flat), 0.02)).mean(2)
S = np.clip(S, 0, 6)
print("shading quantiles 5/50/95/99.5", np.round(np.quantile(S, [.05, .5, .95, .995]), 3))
Image.fromarray((np.clip(S / 2.5, 0, 1) ** (1 / 2.2) * 255).astype(np.uint8)).save(ROOT + "fit/shading_from_reference.png")
px_per_m = SIZE / TILE_M
m = np.ones_like(S, bool)
m[:8] = m[-8:] = False
m[:, :8] = m[:, -8:] = False
valid = np.asarray(Image.open(ROOT + "refs/valid_aligned_2048.png").resize((SIZE, SIZE), Image.NEAREST)) > 128
m &= ndi.binary_erosion(valid, iterations=6)


def normals(height_m_px):
    gx = ndi.sobel(height_m_px, axis=1, mode="nearest") / 8.0
    gy = ndi.sobel(height_m_px, axis=0, mode="nearest") / 8.0
    n = np.dstack([-gx, gy, np.ones_like(gx)])
    return n / np.linalg.norm(n, axis=2, keepdims=True)


def fit(z):
    n = normals(z)
    X = np.stack([n[..., 0][m], n[..., 1][m], n[..., 2][m], np.ones(m.sum())], 1)
    w, *_ = np.linalg.lstsq(X, S[m], rcond=None)
    pred = X @ w
    r2 = 1 - ((S[m] - pred) ** 2).sum() / ((S[m] - S[m].mean()) ** 2).sum()
    light = w[:3] / np.linalg.norm(w[:3])
    return float(r2), light, w


print("--- relief depth search, height only")
best = None
rows = []
for cm in (2, 3, 4, 6, 8, 10, 12, 15, 18, 22, 26, 30, 36, 44, 52, 64):
    z = h * (cm / 100.0) * px_per_m
    r2, light, w = fit(ndi.gaussian_filter(z, 0.7))
    rows.append({"cm": cm, "r2": round(r2, 4), "light": [round(float(x), 3) for x in light]})
    print(cm, "cm  R2", round(r2, 4), "light", np.round(light, 2))
    if best is None or r2 > best[0]:
        best = (r2, cm, light, w)
print("best depth", best[1], "cm, R2", round(best[0], 4), "light", np.round(best[2], 3), "weights", np.round(best[3], 3))
print("--- adding fine lines of the base color as relief (their darkness goes down)")
L = lum_flat
rows2 = []
base_z = h * (best[1] / 100.0) * px_per_m
for sigma in (2, 4, 8):
    fine = L - ndi.gaussian_filter(L, sigma)
    for depth in (0.0, 0.5, 1.0, 2.0, 3.0, 5.0, 8.0):
        z = base_z + fine * (depth / 100.0) * px_per_m
        r2, light, w = fit(ndi.gaussian_filter(z, 0.7))
        rows2.append({"sigma": sigma, "cm": depth, "r2": round(r2, 4)})
        print("sigma", sigma, "cm", depth, "R2", round(r2, 4))
json.dump({"depth": rows, "fine": rows2, "best_cm": best[1], "light": [float(x) for x in best[2]]}, open(ROOT + "fit/measured.json", "w"), indent=1)
