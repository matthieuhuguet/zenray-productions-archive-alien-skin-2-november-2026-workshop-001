            dy, dx = match(band(pred.mean(2)), band(cur.mean(2)), mask, block, step, reach)
            ty, tx = fy + dy, fx + dx
            t = warp(src, ty, tx)
            _, s2 = fit(bins, t, mask)
            kept = s2 > best + 1e-4
